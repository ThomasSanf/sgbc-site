# Copy to .env.local. Never commit the filled file.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local SQLite for development; use libsql://... and a token on Vercel.
DATABASE_URL=file:.data/store.db
DATABASE_AUTH_TOKEN=
# Optional: leave blank until Stripe is configured. Start with test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
