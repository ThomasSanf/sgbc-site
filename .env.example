# Copy to .env.local. Never commit the filled file.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local SQLite for development; use libsql://... and a token on Vercel.
DATABASE_URL=file:.data/store.db
DATABASE_AUTH_TOKEN=
# ECPay card checkout. No credentials are exposed to the browser.
PAYMENT_PROVIDER=ecpay
PUBLIC_ECPAY_SANDBOX=false
# Explicitly choose stage for isolated tests, live for an approved merchant.
# Stage checkout is blocked on Vercel production deployments.
ECPAY_ENVIRONMENT=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# Legacy Stripe integration, only used with PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
